# MIMIC-CXR Anomaly Detection Pipeline Configuration
# Copy this file to .env and fill in your paths

# Required: MIMIC dataset paths
MIMIC_CXR_JPG_PATH=/path/to/mimic-cxr-jpg/2.1.0
MIMIC_IV_PATH=/path/to/mimiciv/3.1
MIMIC_IV_ED_PATH=/path/to/mimic-iv-ed/2.2
CXR_PRO_PATH=/path/to/cxr-pro/1.0.0

# Optional: MIMIC-IV-Note (for additional clinical notes)
MIMIC_IV_NOTE_PATH=/path/to/mimic-iv-note/2.2

# Output directory
OUTPUT_PATH=./output

# Optional: Anthropic API key for text summarization
# ANTHROPIC_API_KEY=sk-ant-...
